(*
PROJECT-LAUNCHER-SPEC v1: generated by Project Launcher (https://github.com/blocher/projectlauncher).
Edit this spec and regenerate (`launcher.py regenerate` on this file, or Regenerate in Project Launcher);
hand edits to the script below are overwritten when it's regenerated.
{
  "spec": 1,
  "id": "dailyoffice",
  "name": "Daily Office",
  "launcher": "StartDailyOfficeDev",
  "url": "http://localhost:{port:Frontend}/",
  "requires": [
    "npm",
    "openssl"
  ],
  "setup": [
    "source {root}/env/bin/activate"
  ],
  "preLaunch": [
    {
      "label": "Trust the development certificate",
      "background": true,
      "run": "cert_path=$(find {root} -type d \\( -name node_modules -o -name .git \\) -prune -o -name development.crt -print | head -n 1); if [ -n \"$cert_path\" ]; then hash=$(openssl x509 -noout -fingerprint -sha1 -in \"$cert_path\" | cut -d= -f2 | tr -d :); if ! security find-certificate -a -Z | grep -q \"$hash\"; then security add-trusted-cert -r trustRoot -k ~/Library/Keychains/login.keychain-db \"$cert_path\"; fi; fi"
    }
  ],
  "panes": [
    {
      "role": "Backend",
      "note": "Django over HTTPS (runsslserver)",
      "dir": "site",
      "port": 8006,
      "command": "python manage.py runsslserver 127.0.0.1:{port}"
    },
    {
      "role": "Frontend",
      "note": "Vite frontend",
      "dir": "app",
      "port": 5176,
      "command": "npm run dev -- --port {port}"
    },
    {
      "role": "Working",
      "command": "git status"
    }
  ]
}
END-PROJECT-LAUNCHER-SPEC
*)

-- Daily Office development environment: one iTerm window, one stacked pane per service.
property projectID : "dailyoffice"

on run
	-- The repo is the folder holding this launcher, so it works in any clone or fork.
	set projectRoot to do shell script "dirname " & quoted form of (POSIX path of (path to me))

	if not iTermInstalled() then
		display alert "iTerm2 is required" message "Install it from https://iterm2.com, then run this launcher again."
		return
	end if
	set missingTools to loginShell(projectRoot, "for t in 'npm' 'openssl'; do command -v \"$t\" >/dev/null || printf \"%s \" \"$t\"; done")
	if missingTools is not "" then
		display alert ("Daily Office needs " & missingTools) message "Install the missing tools (they must be on your login shell's PATH), then run this launcher again."
		return
	end if

	-- Pre-launch step 1: Trust the development certificate
	do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectRoot & "; (" & "cert_path=$(find " & quoted form of projectRoot & " -type d \\( -name node_modules -o -name .git \\) -prune -o -name development.crt -print | head -n 1); if [ -n \"$cert_path\" ]; then hash=$(openssl x509 -noout -fingerprint -sha1 -in \"$cert_path\" | cut -d= -f2 | tr -d :); if ! security find-certificate -a -Z | grep -q \"$hash\"; then security add-trusted-cert -r trustRoot -k ~/Library/Keychains/login.keychain-db \"$cert_path\"; fi; fi" & ") >/dev/null 2>&1 &")

	tell application "Finder" to set screenBounds to bounds of window of desktop

	tell application "iTerm"
		activate
		-- Rerunning replaces this project's window; other iTerm windows are untouched. Each pane gets Ctrl-C
		-- first: closing alone leaves servers that ignore hang-ups (redis-server) running.
		repeat with existingWindow in windows
			try
				tell current session of current tab of existingWindow to set existingTag to variable named "user.launcherProject"
				if existingTag is my projectID then
					repeat with existingSession in sessions of current tab of existingWindow
						tell existingSession to write text (character id 3) newline no
					end repeat
					delay 1.5
					close existingWindow
				end if
			end try
		end repeat

		set devWindow to (create window with default profile)
		set bounds of devWindow to {0, 0, (item 3 of screenBounds) * 0.75, item 4 of screenBounds}

		-- Backend: Django over HTTPS (runsslserver)
		set paneBackend to current session of devWindow
		tell paneBackend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Backend"
			set name to "Daily Office · Backend"
			write text "cd " & quoted form of (projectRoot & "/site")
			write text "export DAILYOFFICE_BACKEND_PORT=${DAILYOFFICE_BACKEND_PORT:-8006} DAILYOFFICE_FRONTEND_PORT=${DAILYOFFICE_FRONTEND_PORT:-5176}"
			write text "source " & quoted form of projectRoot & "/env/bin/activate"
			write text "pids=$(lsof -t -iTCP:$DAILYOFFICE_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$DAILYOFFICE_BACKEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "python manage.py runsslserver 127.0.0.1:$DAILYOFFICE_BACKEND_PORT"
		end tell
		set lastPane to paneBackend

		-- Frontend: Vite frontend
		tell lastPane to set paneFrontend to (split horizontally with default profile)
		tell paneFrontend
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Frontend"
			set name to "Daily Office · Frontend"
			write text "cd " & quoted form of (projectRoot & "/app")
			write text "export DAILYOFFICE_BACKEND_PORT=${DAILYOFFICE_BACKEND_PORT:-8006} DAILYOFFICE_FRONTEND_PORT=${DAILYOFFICE_FRONTEND_PORT:-5176}"
			write text "source " & quoted form of projectRoot & "/env/bin/activate"
			write text "pids=$(lsof -t -iTCP:$DAILYOFFICE_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || { kill $pids 2>/dev/null; sleep 0.5; pids=$(lsof -t -iTCP:$DAILYOFFICE_FRONTEND_PORT -sTCP:LISTEN 2>/dev/null); [ -z \"$pids\" ] || kill -9 $pids 2>/dev/null; }; true"
			write text "npm run dev -- --port $DAILYOFFICE_FRONTEND_PORT"
		end tell
		set lastPane to paneFrontend

		-- Working
		tell lastPane to set paneWorking to (split horizontally with default profile)
		tell paneWorking
			set variable named "user.launcherProject" to my projectID
			set variable named "user.launcherPane" to "Working"
			set name to "Daily Office · Working"
			write text "cd " & quoted form of projectRoot
			write text "export DAILYOFFICE_BACKEND_PORT=${DAILYOFFICE_BACKEND_PORT:-8006} DAILYOFFICE_FRONTEND_PORT=${DAILYOFFICE_FRONTEND_PORT:-5176}"
			write text "source " & quoted form of projectRoot & "/env/bin/activate"
			write text "git status"
		end tell
		set lastPane to paneWorking
	end tell

	-- Open the app in the default browser once its server answers.
	do shell script "(" & "for i in $(seq 1 240); do nc -z 127.0.0.1 5176 2>/dev/null && break; sleep 0.5; done; " & "open " & quoted form of ("http://localhost:5176" & "/") & ") >/dev/null 2>&1 &"
end run

on iTermInstalled()
	try
		do shell script "open -Ra iTerm"
		return true
	on error
		return false
	end try
end iTermInstalled

-- Runs a command in a login shell at the repo root, so tools on the user's PATH (Homebrew, nvm, uv) are found.
on loginShell(projectRoot, command)
	return do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectRoot & " && " & command)
end loginShell
