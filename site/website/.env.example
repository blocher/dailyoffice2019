# Choose openai, elevenlabs, fish, or gemini; restart after changes.
TTS_PROVIDER=openai
# Gemini uses the Gemini API (Generative Language API), not Cloud Text-to-Speech.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Alternative model: gemini-3.8-flash-lite-tts. Style is separate from spoken text.
GEMINI_TTS_STYLE=
# Prebuilt or custom voice_ IDs; blank falls back to these defaults.
GEMINI_TTS_VOICE_LEADER=Kore
GEMINI_TTS_VOICE_CONGREGATION=Sulafat
GEMINI_TTS_VOICE_READER=Charon
GEMINI_TTS_TIMEOUT=180
GEMINI_TTS_MAX_RETRIES=2
