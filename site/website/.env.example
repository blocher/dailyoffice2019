# Optional override: blank preserves the saved Django admin choice.
# Choices: gemini, openai, elevenlabs (alias for elevenlabs_v3), elevenlabs_studio.
# Restart after changes. Gemini handles speech; sound generation remains ElevenLabs-only.
AUDIO_PROVIDER=
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Alternative: gemini-3.8-flash-lite-tts. Style instructions are not spoken text.
GEMINI_TTS_STYLE=
# Blank uses enabled Gemini voices from admin, then Kore/Sulafat/Charon defaults.
# Explicit env voices take precedence over admin; accepts prebuilt or voice_ IDs.
GEMINI_TTS_VOICE_LEADER=
GEMINI_TTS_VOICE_CONGREGATION=
GEMINI_TTS_VOICE_READER=
GEMINI_TTS_TIMEOUT=180
GEMINI_TTS_MAX_RETRIES=2
# Gemini costs remain unpriced unless a Gemini AudioCostRate is configured.
