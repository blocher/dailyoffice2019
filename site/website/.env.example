# Copy to site/website/.env. Development defaults only; never use in production.
# Generate a unique SECRET_KEY before starting Django. Credentials stay blank.
# Optional integrations require their credentials only when you use them.

# Django / local API (matches the README's runsslserver and app/.env.development)
DEBUG=True
DEBUG_DATES=False
USE_CALENDAR_CACHE=False
MODE=web
SECRET_KEY=
SITE_ADDRESS=https://127.0.0.1:8006
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER=http

# Local PostgreSQL. Set the password to match your local role.
# The README's database setup uses 'password' for the dailyoffice role.
POSTGRES_NAME=dailyoffice
POSTGRES_USER=dailyoffice
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Legacy calendar navigation: match these bounds to your imported calendar data.
# Values below match the original example; extend them after importing more years.
FIRST_BEGINNING_YEAR=2018
LAST_BEGINNING_YEAR=2021
FIRST_BEGINNING_YEAR_APP=2019
LAST_BEGINNING_YEAR_APP=2020

# Optional error reporting. BUGSNAG_ENABLED defaults to on when DEBUG is
# False (production) and off when DEBUG is True; set it to override.
BUGSNAG_KEY=
BUGSNAG_ENABLED=False

# Local SMTP capture server (start one on port 1025 to exercise email)
EMAIL_HOST=localhost
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional email rendering / delivery integrations
MAILGUN_PUBLIC_KEY=
MAILGUN_PRIVATE_KEY=
MJML_APPLICATION_ID=
MJML_SECRET_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_PREFIX=us4
MAILCHIMP_LIST_ID=

# Optional SMS reminders; disabled for development
PATRONS_SMS_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional search, media, and meeting integrations
GOOGLE_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
PERPLEXITY_API_KEY=
OMDB_API_KEY=
UTELLY_API_KEY=
IMDB_API_KEY=
YOUTUBE_API_KEY=
ZOOM_LINK=

# Audio generation: openai, elevenlabs, gemini, or fish. Restart after changes.
# Supply the selected provider's API key to generate audio.
TTS_PROVIDER=openai

# OpenAI (also used by non-audio features)
OPENAI_API_KEY=
TTS_MODEL=tts-1
TTS_SPEED=0.95
TTS_VOICE_LEADER=onyx
TTS_VOICE_CONGREGATION=sage
TTS_VOICE_READER=alloy
TTS_INSTRUCTIONS="You are reading the Anglican Daily Office aloud in a worship setting. Speak in a calm, warm, reverent tone at a measured, unhurried pace. Keep the pacing and delivery steady and consistent from line to line, as if leading a congregation in prayer. Do not dramatize or add emotion; read prayerfully, clearly, and naturally. Pronounce 'Amen' as 'ah-men'."

# ElevenLabs. Voice and pronunciation dictionary IDs are account-specific.
# Use eleven_v4 for delivery tags and native IPA, or eleven_v4_turbo for speed.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_SPEED=1.0
ELEVENLABS_TTS_INSTRUCTIONS="[calm]"
ELEVENLABS_TTS_AMEN_IPA=ɑːˈmɛn
ELEVENLABS_TTS_VOICE_LEADER=
ELEVENLABS_TTS_VOICE_CONGREGATION=
# Comma-separated reader voice IDs (maximum 10).
ELEVENLABS_TTS_VOICES_READER=
ELEVENLABS_TTS_TIMEOUT=120
ELEVENLABS_TTS_MAX_RETRIES=4
ELEVENLABS_PRONUNCIATION_DICTIONARY_ID=
ELEVENLABS_PRONUNCIATION_DICTIONARY_VERSION_ID=

# Gemini API. Blank style uses the shared prayer direction.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_ALIGNMENT=True
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TTS_STYLE=
GEMINI_TTS_VOICE_LEADER=Kore
GEMINI_TTS_VOICE_CONGREGATION=Sulafat
GEMINI_TTS_VOICES_READER=Algieba
GEMINI_TTS_TIMEOUT=180
GEMINI_TTS_MAX_RETRIES=2

# Fish Audio. FISH_AUDIO_AI_KEY is the legacy spelling; prefer FISH_AUDIO_API_KEY.
FISH_AUDIO_API_KEY=
FISH_AUDIO_AI_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_TTS_SPEED=0.95
FISH_TTS_SAMPLE_RATE=44100
FISH_TTS_MP3_BITRATE=128
FISH_TTS_TIMEOUT=120
FISH_TTS_MAX_RETRIES=4
FISH_TTS_BACKOFF_BASE=1.0
FISH_TTS_BACKOFF_MAX=30.0
# Public voice reference IDs: Ethan (leader), Laura (congregation), Slax (reader).
FISH_TTS_VOICE_LEADER=536d3a5e000945adb7038665781a4aca
FISH_TTS_VOICE_CONGREGATION=e3cd384158934cc9a01029cd7d278634
FISH_TTS_VOICE_READER=c5f56a6cc2ec4fa8920cb4c5889a3fb7
