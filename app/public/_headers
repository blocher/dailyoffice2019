# Cloudflare Pages headers. The service worker and manifest must be checked
# for updates on every visit (src/offline/pwa.js).
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/site.webmanifest
  Cache-Control: no-cache
# Built scripts and styles carry a content hash in their names, so a copy never
# goes stale. The Caslon fonts (public/assets/fonts) don't: give one a new name
# if it ever changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
