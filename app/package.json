{
  "name": "daily_office",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint .",
    "capacitor:build": "npm run build && node scripts/upload-sourcemaps.mjs --base-url capacitor://localhost --base-url https://localhost && cap sync && cap build",
    "capacitor:serve": "npm run build && cap run",
    "ios": "npm run capacitor:serve -- ios",
    "typecheck": "tsc --noEmit",
    "test:config": "node --test scripts/capacitor-config.check.mjs"
  },
  "dependencies": {
    "@bugsnag/js": "9.1.0",
    "@bugsnag/plugin-vue": "9.1.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.44",
    "vue-axios": "^3.6.0",
    "vue-gtag": "^3.7.1",
    "vue-meta": "^3.0.0-alpha.10",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@bugsnag/source-maps": "2.3.3",
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@vitest/ui": "^5.0.5",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "overrides": {
    "@capacitor-firebase/analytics": {
      "firebase": "$firebase"
    },
    "@capacitor/assets": {
      "sharp": "0.35.5"
    }
  }
}
