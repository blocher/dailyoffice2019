<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: as backup_rules.xml, offline audio stays out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline-audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline-audio/" />
    </device-transfer>
</data-extraction-rules>
