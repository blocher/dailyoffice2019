VITE_API_URL=https://api.dailyoffice2019.com/
VITE_FETCH_AUDIO_ON=true
# Error reporting to Bugsnag (see src/helpers/errorReporting.js). Set to
# false to turn it off. It also needs VITE_BUGSNAG_API_KEY, the API key of a
# Bugsnag JavaScript project, here or in .env.production.local. (Browser
# keys are public: they ship in the bundle.)
VITE_BUGSNAG_ENABLED=true
# VITE_BUGSNAG_API_KEY=
