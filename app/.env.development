VITE_API_URL=https://127.0.0.1:8006/
# Disable audio requests and on-demand generation while developing other features.
# Set to true and restart Vite to work on audio.
VITE_FETCH_AUDIO_ON=false
# Error reporting to Bugsnag (see src/helpers/errorReporting.js). Off while
# developing; set to true, with VITE_BUGSNAG_API_KEY, to try it.
VITE_BUGSNAG_ENABLED=false
